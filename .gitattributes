# Keep source files consistent across Windows, macOS, and Linux checkouts.
* text=auto eol=lf

*.m    text eol=lf
*.md   text eol=lf
*.csv  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binary assets.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.mat  binary
*.mlapp binary
*.mlx  binary
